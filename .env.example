# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Local MongoDB default:
MONGODB_URI=mongodb://127.0.0.1:27017/saanjh_restaurant
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/saanjh_restaurant?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=saanjh_super_secret_session_key_production_replace_this

# Initial Administrator Credentials (used by scripts/seed.js)
ADMIN_EMAIL=admin@saanjh.in
ADMIN_PASSWORD=Admin@123456

# Cloudinary Storage (Optional - falls back to local storage if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
